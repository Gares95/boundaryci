    "format:check": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/check-format.mjs",
    "quality:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/quality-audit.mjs",
    "snapshot:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/snapshot-artifacts.ts",
    "evidence:refresh:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/capture-primary-evidence.ts",
    "build-evidence:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/build-evidence.ts",
    "finalize-decision:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/finalize-decision.ts",
    "assert-production-phase-authorized": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/assert-production-phase-authorized.ts",
