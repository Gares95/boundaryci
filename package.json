  "scripts": {
    "audit:resolved-graph": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- tools/permission-data-feasibility/scripts/audit-lockfile.mjs --lock pnpm-lock.yaml --check tools/permission-data-feasibility/evidence/resolved-graph-candidate.json",
    "test:permission-data-feasibility": "node tools/permission-data-feasibility/scripts/run-offline.mjs -- node_modules/vitest/vitest.mjs run --config vitest.config.ts --reporter=dot",
