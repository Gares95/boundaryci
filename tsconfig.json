{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "tools/permission-data-feasibility/**/*.ts",
    "src/permission-model/**/*.ts",
    "src/analyzer/**/*.ts",
    "src/config/**/*.ts",
    "src/diff/**/*.ts",
    "src/runtime/**/*.ts",
    "src/delivery/**/*.ts",
    "src/cli/**/*.ts",
    "tests/permission-model/**/*.test.ts",
    "tests/analyzer/**/*.test.ts",
    "tests/config/**/*.test.ts",
    "tests/diff/**/*.test.ts",
    "tests/policy/**/*.test.ts",
    "tests/cli/**/*.test.ts"
    ,"tests/delivery/**/*.test.ts"
  ]
}
